  "requirement": {
    "id": "NOTE-01",
    "title": "NOTE-01",
    "text": "NOTE-01：可以新建、选择、编辑、删除便签。每个便签有不变的独立 ID；两个同标题便签独立编辑、删除。"
  },
  "scene": {
    "id": "NOTE-01-S05",
    "title": "同标题便签独立编辑和删除",
    "priority": "P1",
    "priority_reason": "按标题混同记录会使同标题便签无法共存，或导致另一条记录被错误覆盖、删除。",
    "description": "新建并合法保存两个标题完全相同、正文不同的便签，两者均独立存在且 ID 不同；保持同标题分别编辑并保存正文，各自仅呈现自己的修改。删除其中一个后，另一个仍可选择，其 ID、标题与正文保持不变。",
    "requirement_id": "NOTE-01",
    "kind": "BLACK_BOX"
  },
  "business_goal": "交付可在本地独立使用的 Electron 便签应用，支持便签独立管理、合法保存、退出后数据持久化及用户数据隔离，并确保文本展示、数据访问和应用退出安全可靠。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "NOTE-01",
      "NOTE-02",
      "NOTE-03",
      "NOTE-04",
      "NOTE-05",
      "NOTE-06"
    ],
    "exclusions": [
      "其他同时运行的 Electron 应用不在本需求范围内。",
      "质量评审后，每个项目仅正式执行选定的两个测试场景，其他场景不执行。"
    ],
    "limitations": [
      "所有原始需求均须生成场景，正式执行的两个场景尚未选定。",
      "必须运行实际 Electron 桌面应用；项目 README 须提供构建和启动方式，应用须接受独立用户数据目录，不依赖公网或真实用户数据。",
      "非法保存的错误文案及越界 ID 被拒绝时的具体报错形式不作要求。",
      "实际实现及运行行为尚未验证。"
    ]
  },
  "related_requirements": [
    {
      "id": "NOTE-02",
      "title": "NOTE-02",
      "text": "NOTE-02：标题去除首尾空白后必须为 1 至 80 个 Unicode 码点，正文为 0 至 10000 个 Unicode 码点。非法保存显示可见错误且不覆盖最近一次成功保存；错误文案不作要求。"
    },
    {
      "id": "NOTE-03",
      "title": "NOTE-03",
      "text": "NOTE-03：成功保存后完全退出应用再启动，标题与正文一致；删除结果也保留。不同用户数据目录互不影响。"
    },
    {
      "id": "NOTE-06",
      "title": "NOTE-06",
      "text": "NOTE-06：未选择便签时，保存/删除不得损坏现有数据；关闭后没有残留的本应用 Electron 进程。其他同时运行的 Electron 应用不在本需求范围内。"
    }
  ],
