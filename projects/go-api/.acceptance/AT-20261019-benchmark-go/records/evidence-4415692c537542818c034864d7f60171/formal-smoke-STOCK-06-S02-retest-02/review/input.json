  "requirement": {
    "id": "STOCK-06",
    "title": "STOCK-06",
    "text": "STOCK-06：在一次成功 HTTP 响应返回后正常关闭再启动，库存及成功 request_id 的幂等记录必须保留；不同状态目录互不影响。"
  },
  "scene": {
    "id": "STOCK-06-S02",
    "title": "正常重启保留成功请求的完整幂等记录",
    "priority": "P1",
    "priority_reason": "成功记录丢失或恢复不完整会导致重试重复扣减、丢失首次响应，或允许已有请求改量。",
    "description": "在同一状态目录依次以两个不同request_id成功预留2和3，首次响应中的available分别为8和5；成功响应返回后正常关闭并使用原目录重启，两笔请求分别以原quantity重试，应返回200及各自首次响应内容，当前库存保持5。再以第一笔request_id改用quantity为1请求，应返回409且库存仍为5，验证恢复后仍保留该请求原有的数量绑定。",
    "requirement_id": "STOCK-06",
    "kind": "BLACK_BOX"
  },
  "business_goal": "提供初始库存为 10 的本地 HTTP 库存预留服务，支持查询、合法预留和幂等重试，在并发、无效请求及重启后保持库存和成功预留记录一致，并隔离不同状态目录。",
  "confirmed_scope": {
    "included_requirement_ids": [
      "STOCK-01",
      "STOCK-02",
      "STOCK-03",
      "STOCK-04",
      "STOCK-05",
      "STOCK-06"
    ],
    "exclusions": [
      "无需建设身份系统，不依赖网络服务。",
      "所有原始需求均生成场景；质量评审后，本项目仅正式执行两个选定场景，其余场景不执行。"
    ],
    "limitations": [
      "启动入口由 README 给出，输入未提供具体启动命令、localhost 端口及状态目录的配置方式。",
      "额外 JSON 字段允许接受或拒绝，未限定具体策略。",
      "正式执行的两个场景尚未选定。"
    ]
  },
  "related_requirements": [
    {
      "id": "STOCK-01",
      "title": "STOCK-01",
      "text": "STOCK-01：`GET /stock` 返回 JSON `available`，表示当前可用库存，成功状态为 200。"
    },
    {
      "id": "STOCK-02",
      "title": "STOCK-02",
      "text": "STOCK-02：`POST /reserve` 接收 JSON `request_id` 和 `quantity`。request_id 为非空字符串，quantity 为 1 至 10 的整数；合法且库存充足时以 201 返回 `request_id,quantity,available`，库存恰好减少该数量。"
    },
    {
      "id": "STOCK-03",
      "title": "STOCK-03",
      "text": "STOCK-03：同 request_id、同 quantity 的成功预留重试，返回 200 及首次预留的响应内容，不再次扣减。相同 request_id 换 quantity 返回 409，不改变库存。"
    }
  ],
